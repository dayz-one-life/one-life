{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**"] },
    "test": {
      "dependsOn": ["^build"],
      // Declared so they are part of the cache key. Without this, turbo has no idea the
      // database a suite runs against is an input: repointing TEST_DATABASE_URL at a
      // different (or unmigrated) database replays a cached PASS and reports green
      // WITHOUT RUNNING ANYTHING. That has happened here. A test task that can report
      // success it did not earn is worse than no cache at all — add any new env var a
      // suite reads to this list.
      // DEATH_GOLDEN_DIR points at private golden data; suites that read it skip when it is unset,
      // so without it in the key a cached "skipped" PASS would be replayed as if the gate had run.
      // DEATH_GOLDEN_REQUIRED turns that skip into a failure (`pnpm run golden` sets it).
      // DEATH_GOLDEN_DEBUG only adds detail to a failure message, on a private machine.
      "env": ["TEST_DATABASE_URL", "DATABASE_URL", "NODE_ENV", "CI", "DEATH_GOLDEN_DIR", "DEATH_GOLDEN_REQUIRED", "DEATH_GOLDEN_DEBUG"]
    },
    "typecheck": { "dependsOn": ["^build"], "env": ["NODE_ENV"] },
    "lint": {}
  }
}
